# Copy to .env and fill in. Never commit real values.

# Shopify (filled by `shopify app dev`; set these yourself in production).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
# Must match [access_scopes] in shopify.app.toml.
SCOPES=read_orders,read_customers,read_products,write_discounts
# Optional: custom admin domain for the Shopify app library.
SHOP_CUSTOM_DOMAIN=

DATABASE_URL=postgresql://postgres@localhost:5432/giveaways

# Signs entrant and prize-claim tokens (falls back to SHOPIFY_API_SECRET). Long random string.
ENTRANT_TOKEN_SECRET=
# HMAC key for hashing IPs and device ids. Long random string.
FINGERPRINT_SECRET=

# Cloudflare Turnstile bot check on the signup form.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: extra disposable email domains, comma separated.
DISPOSABLE_EMAIL_DOMAINS=

# Resend, for verification codes, winner emails and thank-you codes. Without a key, mail is logged.
RESEND_API_KEY=
MAIL_FROM="Poke-Collect Giveaways <giveaways@poke-collect.com>"

# Klaviyo private API key (scopes: profiles:write, lists:write, subscriptions:write, events:write).
# Used only for giveaways with Klaviyo turned on in their settings.
KLAVIYO_PRIVATE_KEY=

# Signs outbound webhooks (X-Giveaway-Signature: sha256=<hex HMAC of the raw body>).
# Required for giveaways with a webhook URL set; give the same value to the receiver.
OUTBOUND_WEBHOOK_SECRET=
